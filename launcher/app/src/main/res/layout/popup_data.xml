<?xml version="1.0" encoding="utf-8"?>
<!-- Data panel under the Wi-Fi button: Wi-Fi data today, this week, this month, the top apps, and a row
     into Wi-Fi settings. Faces are set in code (Fonts), so reopening it builds no new typefaces. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="6dp"
    android:elevation="12dp">

    <TextView
        android:id="@+id/dataNetwork"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:letterSpacing="0.0083" />

    <LinearLayout
        android:id="@+id/dataTotals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/dataNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:letterSpacing="0.0083"
        android:visibility="gone" />

    <!-- Last 7 days, the week's top app shaded. -->
    <com.gathin.tvhome.WeekBars
        android:id="@+id/weekBars"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="2dp"
        android:background="#1FFFFFFF" />

    <LinearLayout
        android:id="@+id/dataApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />
</LinearLayout>
