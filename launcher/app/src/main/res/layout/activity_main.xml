<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS home: a full-bleed picture, the top row in a glass band low on the screen with the next row
     peeking under it, and one glass capsule top right with the time and the TV controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- The wallpaper is added here at index 0 (MainActivity.showWallpaper). -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shelf_scrim" />

    <!-- Out of the top shelf, the picture sinks back behind the grid. -->
    <View
        android:id="@+id/gridShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:alpha="0" />

    <!-- Full screen; MainActivity pads the top so the top row lands at tvOS's height. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingBottom="40dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants" />

    <!-- Top left: the greeting, and under it a row of glass widgets (time and date, weather, data), as on
         iPad and StandBy. Numerals in SF Pro Rounded, labels in SF Pro Text. -->
    <LinearLayout
        android:id="@+id/welcomeBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="60dp"
        android:layout_marginTop="28dp"
        android:orientation="vertical">

        <!-- Greeting on one line: time-of-day icon, "Good evening," in SF Pro medium, then the name in semibold,
             tinted by the time of day (MainActivity.updateGreeting). Faces are set as spans from Fonts. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/greetIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#D9FFFFFF"
                android:textSize="26sp"
                android:letterSpacing="0.0083"
                android:fontFamily="@font/sf_pro"
                android:shadowColor="#73000000"
                android:shadowDy="2"
                android:shadowRadius="14"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Ghana's red, gold and green, on national days only. -->
        <LinearLayout
            android:id="@+id/flagLine"
            android:layout_width="84dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:background="@drawable/flag_clip"
            android:clipToOutline="true"
            android:visibility="gone">
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFCE1126" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFCD116" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FF006B3F" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Time and date. -->
            <LinearLayout
                android:layout_width="214dp"
                android:layout_height="108dp"
                android:background="@drawable/widget_glass"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFFFFFFF"
                    android:textSize="44sp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="@font/sf_pro_rounded_semibold"
                    android:includeFontPadding="false" />

                <TextClock
                    android:id="@+id/dateLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:format12Hour="EEEE, d MMMM"
                    android:format24Hour="EEEE, d MMMM"
                    android:singleLine="true"
                    android:textColor="#C7FFFFFF"
                    android:textSize="14sp"
                    android:letterSpacing="0.0137"
                    android:fontFamily="@font/sf_pro"
                    android:fontVariationSettings="'wght' 500, 'opsz' 28" />
            </LinearLayout>

            <!-- Weather: icon and temperature, condition and range, then the note (rain, heat) or the place. -->
            <LinearLayout
                android:id="@+id/weatherRow"
                android:layout_width="230dp"
                android:layout_height="108dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/widget_glass"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/wxIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/wxTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="#FFFFFFFF"
                        android:textSize="36sp"
                        android:fontFamily="@font/sf_pro_rounded_semibold"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/wxText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#F2FFFFFF"
                    android:textSize="14sp"
                    android:letterSpacing="0.0137"
                    android:fontFamily="@font/sf_pro"
                    android:fontVariationSettings="'wght' 500, 'opsz' 28" />

                <TextView
                    android:id="@+id/wxNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="#A6FFFFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.0057"
                    android:fontFamily="@font/sf_pro"
                    android:fontVariationSettings="'wght' 500, 'opsz' 24" />
            </LinearLayout>

            <!-- Wi-Fi data used this month, read in the background when Home opens. -->
            <LinearLayout
                android:id="@+id/dataLine"
                android:layout_width="150dp"
                android:layout_height="108dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/widget_glass"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/dataValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="32sp"
                    android:fontFamily="@font/sf_pro_rounded_semibold"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/data_this_month"
                    android:singleLine="true"
                    android:textColor="#C7FFFFFF"
                    android:textSize="14sp"
                    android:letterSpacing="0.0137"
                    android:fontFamily="@font/sf_pro"
                    android:fontVariationSettings="'wght' 500, 'opsz' 28" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/capsule"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:background="@drawable/glass_capsule"
        android:animateLayoutChanges="true">


        <TextView
            android:id="@+id/btnInputs"
            style="@style/CapsuleButton"
            android:contentDescription="@string/inputs"
            android:drawableStart="@drawable/ic_input" />

        <TextView
            android:id="@+id/btnWifi"
            style="@style/CapsuleButton"
            android:maxWidth="220dp"
            android:ellipsize="end"
            android:contentDescription="@string/wifi"
            android:drawableStart="@drawable/ic_wifi" />

        <TextView
            android:id="@+id/btnSettings"
            style="@style/CapsuleButton"
            android:contentDescription="@string/settings"
            android:drawableStart="@drawable/ic_settings" />
    </LinearLayout>
</FrameLayout>
