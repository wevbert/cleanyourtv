<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS home: a full-bleed picture, the top row in a glass band low on the screen with the next row
     peeking under it, and one glass capsule top right with the time and the TV controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- The wallpaper is added here at index 0 (MainActivity.showWallpaper). -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shelf_scrim" />

    <!-- Out of the top shelf, the picture sinks back behind the grid. -->
    <View
        android:id="@+id/gridShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:alpha="0" />

    <!-- Full screen; MainActivity pads the top so the top row lands at tvOS's height. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingBottom="40dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants" />

    <LinearLayout
        android:id="@+id/capsule"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="5dp"
        android:background="@drawable/glass_capsule"
        android:animateLayoutChanges="true">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#F2FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.0083"
            android:fontFamily="@font/sf_pro"
            android:fontVariationSettings="'wght' 590, 'opsz' 26"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/btnInputs"
            style="@style/CapsuleButton"
            android:contentDescription="@string/inputs"
            android:drawableStart="@drawable/ic_input" />

        <TextView
            android:id="@+id/btnWifi"
            style="@style/CapsuleButton"
            android:maxWidth="220dp"
            android:ellipsize="end"
            android:contentDescription="@string/wifi"
            android:drawableStart="@drawable/ic_wifi" />

        <TextView
            android:id="@+id/btnSettings"
            style="@style/CapsuleButton"
            android:contentDescription="@string/settings"
            android:drawableStart="@drawable/ic_settings" />
    </LinearLayout>
</FrameLayout>
