<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS home: a full-bleed picture, the top row in a glass band low on the screen with the next row
     peeking under it, and one glass capsule top right with the time and the TV controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- The wallpaper is added here at index 0 (MainActivity.showWallpaper). -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shelf_scrim" />

    <!-- Out of the top shelf, the picture sinks back behind the grid. -->
    <View
        android:id="@+id/gridShade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:alpha="0" />

    <!-- Full screen; MainActivity pads the top so the top row lands at tvOS's height. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingBottom="40dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:descendantFocusability="afterDescendants" />

    <!-- Top left, where tvOS sets a show's title: the greeting, and the weather under it. -->
    <LinearLayout
        android:id="@+id/welcomeBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="60dp"
        android:layout_marginTop="28dp"
        android:orientation="vertical">

        <!-- SF Pro Display semibold at 60pt, Apple's tracking for that size. -->
        <TextView
            android:id="@+id/welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:letterSpacing="0.0044"
            android:fontFamily="@font/sf_pro"
            android:fontVariationSettings="'wght' 600, 'opsz' 28"
            android:shadowColor="#73000000"
            android:shadowDy="2"
            android:shadowRadius="14"
            android:includeFontPadding="false" />

        <!-- Ghana's red, gold and green, on national days only. -->
        <LinearLayout
            android:id="@+id/flagLine"
            android:layout_width="84dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:background="@drawable/flag_clip"
            android:clipToOutline="true"
            android:visibility="gone">
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFCE1126" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FFFCD116" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FF006B3F" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/weatherRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/wxIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/wxTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:letterSpacing="0.0115"
                android:fontFamily="@font/sf_pro"
                android:fontVariationSettings="'wght' 600, 'opsz' 28"
                android:fontFeatureSettings="tnum"
                android:shadowColor="#73000000"
                android:shadowDy="1"
                android:shadowRadius="10" />

            <TextView
                android:id="@+id/wxText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:singleLine="true"
                android:textColor="#E0FFFFFF"
                android:textSize="15sp"
                android:letterSpacing="0.0132"
                android:fontFamily="@font/sf_pro"
                android:fontVariationSettings="'wght' 500, 'opsz' 28"
                android:shadowColor="#73000000"
                android:shadowDy="1"
                android:shadowRadius="10" />
        </LinearLayout>

        <!-- Rain coming, or a hot day; empty otherwise. -->
        <TextView
            android:id="@+id/wxNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"
            android:textColor="#C7FFFFFF"
            android:textSize="14sp"
            android:letterSpacing="0.0137"
            android:fontFamily="@font/sf_pro"
            android:fontVariationSettings="'wght' 500, 'opsz' 28"
            android:shadowColor="#73000000"
            android:shadowDy="1"
            android:shadowRadius="10"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/capsule"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="5dp"
        android:background="@drawable/glass_capsule"
        android:animateLayoutChanges="true">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#F2FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.0083"
            android:fontFamily="@font/sf_pro"
            android:fontVariationSettings="'wght' 590, 'opsz' 26"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/btnInputs"
            style="@style/CapsuleButton"
            android:contentDescription="@string/inputs"
            android:drawableStart="@drawable/ic_input" />

        <TextView
            android:id="@+id/btnWifi"
            style="@style/CapsuleButton"
            android:maxWidth="220dp"
            android:ellipsize="end"
            android:contentDescription="@string/wifi"
            android:drawableStart="@drawable/ic_wifi" />

        <TextView
            android:id="@+id/btnSettings"
            style="@style/CapsuleButton"
            android:contentDescription="@string/settings"
            android:drawableStart="@drawable/ic_settings" />
    </LinearLayout>
</FrameLayout>
