<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream), tvOS aerial style (SF Pro faces are set in code, from Fonts): an aerial drifting slowly, the time top right, the place
     bottom right, and the greeting and weather bottom left. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/photoA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/photoB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <TextClock
        android:id="@+id/dreamClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="56dp"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp"
        android:letterSpacing="0.0137"
        android:fontFeatureSettings="tnum"
        android:shadowColor="#80000000"
        android:shadowDy="2"
        android:shadowRadius="14" />

    <LinearLayout
        android:id="@+id/dreamText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="56dp"
        android:layout_marginBottom="48dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dreamGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:letterSpacing="0.0044"
            android:shadowColor="#80000000"
            android:shadowDy="2"
            android:shadowRadius="14"
            android:includeFontPadding="false" />

        <LinearLayout
            android:id="@+id/dreamWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/dreamWxIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/dreamWxText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:textColor="#F2FFFFFF"
                android:textSize="17sp"
                android:letterSpacing="0.0115"
                android:shadowColor="#80000000"
                android:shadowDy="1"
                android:shadowRadius="10" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/dreamPlace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="50dp"
        android:singleLine="true"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:letterSpacing="0.0137"
        android:shadowColor="#80000000"
        android:shadowDy="1"
        android:shadowRadius="10" />
</FrameLayout>
