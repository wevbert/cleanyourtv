<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/sf_pro</item>
        <item name="android:letterSpacing">0.0132</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />

    <!-- Icon button inside the time capsule; on focus it fills white and opens to show its label. -->
    <style name="CapsuleButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/round_btn_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.0083</item>
        <item name="android:fontFamily">@font/sf_pro</item>
        <item name="android:singleLine">true</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="CapsuleButton" parent="CapsuleButtonBase" />
</resources>
